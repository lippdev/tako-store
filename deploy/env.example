# Variáveis de ambiente de produção. Copiado para /etc/tako-store/env (permissão 0600, dono do serviço).
# Nenhum valor real vai para o repositório.

# Banco (obrigatório)
DATABASE_URL=postgres://usuario:senha@localhost:5432/tako_store

# Porta do servidor Next (padrão 3000 no `npm run start`; o compose local usa 5174)
PORT=3000

# 0 desliga o aviso de catálogo fictício e esconde as credenciais de demonstração do login.
# Só coloque 0 quando o catálogo tiver dado real.
DEMO_CATALOG=1
